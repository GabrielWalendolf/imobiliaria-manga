<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.edu.univille.poo.controller.GerenciarClientesController">
    <children>
        <Label layoutX="30.0" layoutY="25.0" text="Gerenciar Clientes">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>
        <TableView fx:id="tableViewClientes" layoutX="30.0" layoutY="70.0" prefHeight="450.0" prefWidth="840.0">
            <columns>
                <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                <TableColumn fx:id="colNomeCompleto" prefWidth="250.0" text="Nome Completo" />
                <TableColumn fx:id="colCpf" prefWidth="120.0" text="CPF" />
                <TableColumn fx:id="colTelefone" prefWidth="120.0" text="Telefone" />
                <TableColumn fx:id="colEmail" prefWidth="180.0" text="Email" />
                <TableColumn fx:id="colDataCadastro" prefWidth="120.0" text="Data Cadastro" />
            </columns>
        </TableView>
        <HBox layoutX="30.0" layoutY="540.0" spacing="10.0">
            <children>
                <Button onAction="#handleAtualizarCliente" text="Atualizar Cliente" />
                <Button onAction="#handleDeletarCliente" text="Deletar Cliente" />
            </children>
        </HBox>
    </children>
</AnchorPane>
