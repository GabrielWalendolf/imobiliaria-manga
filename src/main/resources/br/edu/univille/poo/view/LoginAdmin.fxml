<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" styleClass="root" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.edu.univille.poo.controller.LoginAdminController">
    <padding>
        <Insets bottom="40.0" left="50.0" right="50.0" top="40.0" />
    </padding>

    <Label styleClass="title-label" text="Acesso Restrito" />

    <VBox spacing="10.0" maxWidth="300">
        <children>
            <Label text="Usuário:" styleClass="form-label" />
            <TextField fx:id="campoUsuario" promptText="Digite seu usuário" styleClass="form-textfield" />
        </children>
    </VBox>

    <VBox spacing="10.0" maxWidth="300">
        <children>
            <Label text="Senha:" styleClass="form-label" />
            <PasswordField fx:id="campoSenha" promptText="Digite sua senha" styleClass="form-textfield" />
        </children>
    </VBox>

    <Button fx:id="botaoLogin" defaultButton="true" mnemonicParsing="false" onAction="#realizarLogin" styleClass="button-save" text="Entrar" />

</VBox>
