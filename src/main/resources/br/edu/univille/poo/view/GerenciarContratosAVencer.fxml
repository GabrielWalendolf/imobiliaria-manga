<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" stylesheets="@../style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.edu.univille.poo.controller.GerenciarContratosAVencerController">
    <children>
        <Label layoutX="30.0" layoutY="25.0" styleClass="title-text" text="Gerenciar Contratos a Vencer" />
        <TableView fx:id="tableViewContratos" layoutX="30.0" layoutY="70.0" prefHeight="450.0" prefWidth="840.0">
            <columns>
                <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                <TableColumn fx:id="colCliente" prefWidth="150.0" text="Cliente" />
                <TableColumn fx:id="colImovel" prefWidth="150.0" text="Imóvel" />
                <TableColumn fx:id="colValorAluguel" prefWidth="100.0" text="Valor Aluguel" />
                <TableColumn fx:id="colDataInicio" prefWidth="100.0" text="Data Início" />
                <TableColumn fx:id="colDataFim" prefWidth="100.0" text="Data Fim" />
                <TableColumn fx:id="colStatusContrato" prefWidth="100.0" text="Status" />
            </columns>
        </TableView>
        <HBox layoutX="30.0" layoutY="540.0" spacing="10.0">
            <children>
                <Button onAction="#handleAtualizarContrato" prefHeight="30.0" prefWidth="140.0" text="Atualizar Contrato" />
                <Button onAction="#handleDeletarContrato" prefHeight="30.0" prefWidth="140.0" text="Deletar Contrato" />
            </children>
        </HBox>
    </children>
</AnchorPane>


